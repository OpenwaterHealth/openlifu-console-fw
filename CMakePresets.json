{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Debug-BareMetal",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BARE_METAL": "ON"
            }
        },
        {
            "name": "Release-BareMetal",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BARE_METAL": "ON"
            }
        },
        {
            "name": "Debug-FDA",
            "inherits": "default",
            "displayName": "Debug (FDA mode)",
            "description": "Debug FDA build: the one preset's HV entry is linked in at the end of the application slot (page 61, Core/Inc/presets/fda_preset.h from the SDK's generate_presets.py); the HV voltage comes from it, not the host.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "FDA_MODE": "ON"
            }
        },
        {
            "name": "Release-FDA",
            "inherits": "default",
            "displayName": "Release (FDA mode)",
            "description": "Release FDA build: the one preset's HV entry is linked in at the end of the application slot (page 61, Core/Inc/presets/fda_preset.h from the SDK's generate_presets.py); the HV voltage comes from it, not the host.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "FDA_MODE": "ON"
            }
        },
        {
            "name": "Release-FDA-BareMetal",
            "inherits": "default",
            "displayName": "Release (FDA mode, bare metal)",
            "description": "Standalone FDA build, no bootloader: FLASH @ 0x08000000, the preset at the same page 61 as under the bootloader. For bench work.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BARE_METAL": "ON",
                "FDA_MODE": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Debug-BareMetal",
            "configurePreset": "Debug-BareMetal"
        },
        {
            "name": "Release-BareMetal",
            "configurePreset": "Release-BareMetal"
        },
        {
            "name": "Debug-FDA",
            "configurePreset": "Debug-FDA"
        },
        {
            "name": "Release-FDA",
            "configurePreset": "Release-FDA"
        },
        {
            "name": "Release-FDA-BareMetal",
            "configurePreset": "Release-FDA-BareMetal"
        }
    ]
}
