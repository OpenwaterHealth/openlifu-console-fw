{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Debug-BareMetal",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BARE_METAL": "ON"
            }
        },
        {
            "name": "Release-BareMetal",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BARE_METAL": "ON"
            }
        },
        {
            "name": "Debug-FDA",
            "inherits": "default",
            "displayName": "Debug (FDA mode)",
            "description": "Debug FDA build, bare metal like the transmitter's: the HV voltage comes from the selected preset, not the host.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BARE_METAL": "ON",
                "FDA_MODE": "ON"
            }
        },
        {
            "name": "Release-FDA",
            "inherits": "default",
            "displayName": "Release (FDA mode)",
            "description": "Release FDA build, bare metal like the transmitter's: the HV voltage comes from the selected preset, not the host.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BARE_METAL": "ON",
                "FDA_MODE": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Debug-BareMetal",
            "configurePreset": "Debug-BareMetal"
        },
        {
            "name": "Release-BareMetal",
            "configurePreset": "Release-BareMetal"
        },
        {
            "name": "Debug-FDA",
            "configurePreset": "Debug-FDA"
        },
        {
            "name": "Release-FDA",
            "configurePreset": "Release-FDA"
        }
    ]
}
